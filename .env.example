# Oracle source DB
ORACLE_USERNAME=
ORACLE_PASSWORD=
ORACLE_DB_HOST=
ORACLE_SERVICE_NAME=
ORACLE_PORT=1521
ORACLE_QUERY_TIMEOUT_MS=600000
ORACLE_WORKERS=4
ORACLE_ARRAYSIZE=10000
ORACLE_PREFETCH=10001

# Elasticsearch — at least one of stage/prod required
ES_URL_STAGE=
ES_URL_PRODE=
ES_USER=
ES_PASS=
ES_VERIFY=false
ES_PAGE_SIZE=10000
ES_TIMEOUT_CONNECT=5
ES_TIMEOUT_READ=300

# Pipeline runtime
PIPELINE_WORKERS=4
PIPELINE_SAVE_FULL_CSV=0
PIPELINE_VERBOSE=0
PIPELINE_DIFF_MODE=both
PIPELINE_SKIP_PG_SYNC=0
PIPELINE_KEEP_CSV=0

# apply_changes audit log
APPLY_LOG_ENABLED=1
APPLY_LOG_DIR_STAGE=out/_apply_log/stage
APPLY_LOG_DIR_PRODE=out/_apply_log/prode
APPLY_BATCH_SIZE=1000
APPLY_POLL_INTERVAL_SEC=2.0

# Postgres mirror
PG_HOST=
PG_PORT=5432
PG_DB=
PG_USER=
PG_PASSWORD=
PG_SCHEMA=public
PG_SSLMODE=prefer
PG_QUERY_TIMEOUT_MS=600000
PG_CONNECT_TIMEOUT=5
